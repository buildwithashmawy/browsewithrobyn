# ─────────────────────────────────────────────────────────────
# Robyn — Browser Agent · environment variables
# Copy the relevant blocks into apps/web/.env.local and apps/agent/.env
# ─────────────────────────────────────────────────────────────

# Convex deployment URL — run `npx convex dev` once to create a deployment;
# it prints this URL (looks like https://<name>.convex.cloud).
# Web reads NEXT_PUBLIC_CONVEX_URL; the agent reads CONVEX_URL. Same value.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=

# Agent HTTP service (the long-lived Playwright process).
# The web app forwards start/stop to this URL server-side (never exposed to the browser).
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
PORT=8787

# OpenRouter — YOUR own key (https://openrouter.ai/keys). Used ONLY by the agent.
OPENROUTER_API_KEY=
# Default/fallback model for the picker (runtime-selectable in the UI).
# Must be a vision-capable model (the agent sends screenshots).
OPENROUTER_MODEL=anthropic/claude-sonnet-4
